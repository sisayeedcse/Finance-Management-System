"59":"        } catch (Throwable $e) {","60":"            $this-\u003EhandleViewException($e, $obLevel);","61":"        }","62":"","63":"        return ltrim(ob_get_clean());","64":"    }","65":"","66":"    \/**","67":"     * Handle a view exception.","68":"     *","69":"     * @param  \\Throwable  $e","70":"     * @param  int  $obLevel","71":"     * @return void","72":"     *"},"arguments":[{"name":"path","value":"D:\\Softwares\\SIPR\\sipr-group\\storage\\framework\\views\/c738e85e9b62c5be476de3948afcac8e.php","original_type":"string","passed_by_reference":false,"is_variadic":false,"truncated":false},{"name":"data","value":{"__env":"object (Illuminate\\View\\Factory)","app":"object (Illuminate\\Foundation\\Application)","month_label":"May","year":2026,"members":"object (Illuminate\\Database\\Eloquent\\Collection)","payments":"object (Illuminate\\Database\\Eloquent\\Collection)","total_due":4500,"collected":0},"original_type":"array","passed_by_reference":false,"is_variadic":false,"truncated":false}],"application_frame":false},{"file":"D:\\Softwares\\SIPR\\sipr-group\\vendor\\laravel\\framework\\src\\Illuminate\\View\\Engines\\CompilerEngine.php","line_number":75,"method":"get","class":"Illuminate\\View\\Engines\\CompilerEngine","code_snippet":{"60":"    {","61":"        $this-\u003ElastCompiled[] = $path;","62":"","63":"        \/\/ If this given view has expired, which means it has simply been edited since","64":"        \/\/ it was last compiled, we will re-compile the views so we can evaluate a","65":"        \/\/ fresh copy of the view. We\u0027ll pass the compiler the path of the view.","66":"        if (! isset($this-\u003EcompiledOrNotExpired[$path]) \u0026\u0026 $this-\u003Ecompiler-\u003EisExpired($path)) {","67":"            $this-\u003Ecompiler-\u003Ecompile($path);","68":"        }","69":"","70":"        \/\/ Once we have the path to the compiled file, we will evaluate the paths with","71":"        \/\/ typical PHP just like any other templates. We also