the number of views being rendered so we can flush","186":"        \/\/ the section after the complete rendering operation is done. This will","187":"        \/\/ clear out the sections for any separate views that may be rendered.","188":"        $this-\u003Efactory-\u003EincrementRender();","189":"","190":"        $this-\u003Efactory-\u003EcallComposer($this);","191":"","192":"        $contents = $this-\u003EgetContents();","193":"","194":"        \/\/ Once we\u0027ve finished rendering the view, we\u0027ll decrement the render count","195":"        \/\/ so that each section gets flushed out next time a view is created and","196":"        \/\/ no old sections are staying around in the memory of an environment.","197":"        $this-\u003Efactory-\u003EdecrementRender();","198":"","199":"        return $contents;","200":"    }","201":"","202":"    \/**","203":"     * Get the evaluated contents of the view.","204":"     *","205":"     * @return string","206":"     *\/"},"arguments":[],"application_frame":false},{"file":"D:\\Softwares\\SIPR\\sipr-group\\vendor\\laravel\\framework\\src\\Illuminate\\View\\View.php","line_number":161,"method":"render","class":"Illuminate\\View\\View","code_snippet":{"146":"    {","147":"        return (new Collection($this-\u003Erender(fn () =\u003E $this-\u003Efactory-\u003EgetFragments())))-\u003Eimplode(\u0027\u0027);","148":"    }","149":"","150":"    \/**","151":"     * Get the string contents of the view.","152":"     *","153":"     * @param  callable|null  $callback","154":"     * @return string","155":"     *","156":"     * @throws \\Throwable","157":"     *\/","158":"    public function render(?callable $callback = null)","159":"    {","160":"        try {","161":"            $contents = $this-\u003ErenderContents();","162":"","163":"            $response = isset($callback) ? $callback($this, $contents) : null;","164":"","165":"            \/\/ Once we have the contents of the view, we will flush the sections if we are","166":" 